{
  "name": "schemaforge",
  "version": "0.1.0",
  "description": "AI-powered schema migration and code transformation platform",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "ts-node --project tsconfig.test.json src/main.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
