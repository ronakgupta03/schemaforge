# Environment Variables — SchemaForge
#
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
#
# All variables are optional at startup; individual feature modules
# will throw ConfigMissingError at use-time if a required var is absent.

# Application environment: development | test | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── LLM Integration (required for TrueForge agent calls) ─────────────────────
# Google AI / Gemini API key
# GOOGLE_API_KEY=your-api-key-here

# ── Database Connectivity (required for DB analysis stage) ────────────────────
# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/schemaforge

# ── MCP Server (NOT YET IMPLEMENTED) ─────────────────────────────────────────
# MCP_SERVER_URL=http://localhost:3000
